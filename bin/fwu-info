#!/usr/bin/env python3
"""Report CSME state and MEI client reachability.

Read-only. Opens the FWU client to read its negotiated limits and closes it
without sending anything; the only message written to the ME is the MKHI
version query.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

from fwu import clients, fwu, mkhi  # noqa: E402
from fwu.mei import DEFAULT_DEVICE, MeiError, probe  # noqa: E402

SYSFS = "/sys/class/mei/mei0"


def _sysfs(name):
    try:
        with open(os.path.join(SYSFS, name)) as handle:
            return handle.read().strip()
    except OSError:
        return "(unavailable)"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--device", default=DEFAULT_DEVICE)
    args = parser.parse_args()

    print("sysfs")
    print(f"  dev_state : {_sysfs('dev_state')}")
    print(f"  fw_ver    : {' '.join(_sysfs('fw_ver').split())}")
    print(f"  hbm_ver   : {_sysfs('hbm_ver')}")

    print("\nMEI clients")
    for name in ("fwu", "mkhi"):
        try:
            max_msg, proto = probe(clients.BY_NAME[name], args.device)
            print(f"  {name:<5}: max_msg={max_msg} B  proto_ver={proto}")
        except MeiError as exc:
            print(f"  {name:<5}: unreachable - {exc}")

    print("\nMKHI GET_FW_VERSION")
    mkhi_version = None
    try:
        for label, version in mkhi.get_fw_version(args.device):
            print(f"  {label:<12}: {version}")
            if mkhi_version is None:
                mkhi_version = version
    except (MeiError, ValueError) as exc:
        print(f"  failed - {exc}")

    print("\nFWU GET_VERSION (legacy command 0)")
    try:
        record = fwu.get_version_raw(args.device)
        version = fwu.parse_version(record)
        print(f"  record      : {len(record)} B")
        print(f"  version     : {version}")
        if mkhi_version and version != mkhi_version:
            print(f"  MISMATCH against MKHI ({mkhi_version})")
            return 1
    except fwu.CommandRejected as exc:
        print(f"  not served on this generation - {exc}")
    except (MeiError, ValueError) as exc:
        print(f"  failed - {exc}")
        return 1

    if mkhi_version is None:
        print("\nno version source succeeded")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
